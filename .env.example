# Copy to .env.local and fill in real values. Never commit .env.local.
# Public (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only (never exposed to the browser; validated in src/lib/env/server.ts)
SUPABASE_SECRET_KEY=sb_secret_xxx
SANDBOX_SIGNING_SECRET=generate-with-openssl-rand-hex-32
CERTIFICATE_SIGNING_SECRET=generate-with-openssl-rand-hex-32
CRON_SECRET=generate-with-openssl-rand-hex-32

# Payments (sandbox/test credentials only until production is explicitly approved)
PAYMENT_PROVIDERS=manual,hotmart
HOTMART_CLIENT_ID=xxx
HOTMART_CLIENT_SECRET=xxx
HOTMART_WEBHOOK_HOTTOK=xxx
# MERCADOPAGO_ACCESS_TOKEN=TEST-xxx   (Phase 6b)
# MERCADOPAGO_WEBHOOK_SECRET=xxx
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# Optional
# ANALYTICS_PROVIDER=first-party
